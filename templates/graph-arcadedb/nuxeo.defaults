## DO NOT EDIT THIS FILE, USE nuxeo.conf  ##
## The default repository (documents and folders) in ArcadeDB; everything else (users and groups, directories, audit,
## key/value store) in PostgreSQL: the postgresql template, whose repository configuration this template replaces.
## The audit is in PostgreSQL only with the nuxeo-audit-sql package and its sql-audit template (as in the Docker image).
nuxeo.template.includes=postgresql
graph-arcadedb.target=.

## the ArcadeDB server (HTTP API); the database must exist and be dedicated to the repository
nuxeo.arcadedb.host=localhost
nuxeo.arcadedb.port=2480
nuxeo.arcadedb.database=nuxeo
nuxeo.arcadedb.username=root
nuxeo.arcadedb.password=
