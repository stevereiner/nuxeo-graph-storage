## DO NOT EDIT THIS FILE, USE nuxeo.conf  ##
## The default repository (documents and folders) in Neo4j; everything else (users and groups, directories, audit,
## key/value store) in PostgreSQL: the postgresql template, whose repository configuration this template replaces.
## The audit is in PostgreSQL only with the nuxeo-audit-sql package and its sql-audit template (as in the Docker image).
nuxeo.template.includes=postgresql
graph-neo4j.target=.

nuxeo.neo4j.uri=bolt://localhost:7687
nuxeo.neo4j.username=neo4j
## no password: no authentication
#nuxeo.neo4j.password=
## the server's default database if not set
#nuxeo.neo4j.database=
nuxeo.neo4j.transactionTimeout=300
