<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.integratedsemantics.nuxeo.graph</groupId>
    <artifactId>nuxeo-graph-storage-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nuxeo-graph-storage-core-tests</artifactId>
  <name>Nuxeo Graph Storage - Nuxeo Core Tests</name>
  <description>Runs Nuxeo's own core repository test classes against a graph storage backend</description>

  <properties>
    <!-- backend under test: neo4j, arcadedb, or mem (baseline: Nuxeo's own in-memory backend) -->
    <nuxeo.test.graph>neo4j</nuxeo.test.graph>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.nuxeo.ecm.core</groupId>
      <artifactId>nuxeo-core-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- the Nuxeo core repository tests themselves -->
      <groupId>org.nuxeo.ecm.core</groupId>
      <artifactId>nuxeo-core-test</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.nuxeo.ecm.core</groupId>
      <artifactId>nuxeo-core-storage-mem</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- tests only: no jar (Nuxeo's jar configuration requires a bundle manifest), so nothing to install -->
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>default-jar</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-install-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit4</artifactId>
            <version>3.5.5</version>
          </dependency>
        </dependencies>
        <configuration>
          <!-- a failing Nuxeo test must not stop the others: read the report -->
          <testFailureIgnore>true</testFailureIgnore>
          <!-- don't let a hanging test block the whole run -->
          <forkedProcessTimeoutInSeconds>2400</forkedProcessTimeoutInSeconds>
          <systemPropertyVariables>
            <nuxeo.test.core>mem</nuxeo.test.core>
            <nuxeo.test.graph>${nuxeo.test.graph}</nuxeo.test.graph>
            <nuxeo.test.arcadedb.version>${arcadedb.version}</nuxeo.test.arcadedb.version>
            <nuxeo.test.neo4j.version>${neo4j.version}</nuxeo.test.neo4j.version>
            <!-- external Neo4j instead of a Testcontainers Neo4j container: -->
            <!-- <nuxeo.test.neo4j.uri>bolt://localhost:7687</nuxeo.test.neo4j.uri> -->
            <!-- <nuxeo.test.neo4j.username>neo4j</nuxeo.test.neo4j.username> -->
            <!-- <nuxeo.test.neo4j.password>password</nuxeo.test.neo4j.password> -->
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- the dependencies of the backend under test are selected by -Dnuxeo.test.graph -->
  <profiles>
    <profile>
      <id>graph-neo4j</id>
      <activation>
        <property>
          <name>nuxeo.test.graph</name>
          <value>!arcadedb</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.integratedsemantics.nuxeo.graph</groupId>
          <artifactId>nuxeo-core-storage-neo4j</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.integratedsemantics.nuxeo.graph</groupId>
          <artifactId>nuxeo-core-storage-neo4j</artifactId>
          <type>test-jar</type>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.testcontainers</groupId>
          <artifactId>testcontainers-neo4j</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>graph-arcadedb</id>
      <activation>
        <property>
          <name>nuxeo.test.graph</name>
          <value>arcadedb</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.integratedsemantics.nuxeo.graph</groupId>
          <artifactId>nuxeo-core-storage-arcadedb</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.integratedsemantics.nuxeo.graph</groupId>
          <artifactId>nuxeo-core-storage-arcadedb</artifactId>
          <type>test-jar</type>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.testcontainers</groupId>
          <artifactId>testcontainers</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>com.arcadedb</groupId>
          <artifactId>arcadedb-server</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.locationtech.jts</groupId>
          <artifactId>jts-core</artifactId>
          <version>${arcadedb.jts.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.antlr</groupId>
          <artifactId>antlr4-runtime</artifactId>
          <version>${arcadedb.antlr4.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.graalvm.sdk</groupId>
          <artifactId>graal-sdk</artifactId>
          <version>${arcadedb.graalvm.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.graalvm.polyglot</groupId>
          <artifactId>polyglot</artifactId>
          <version>${arcadedb.graalvm.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

</project>
