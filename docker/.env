# Settings of docker/compose.neo4j.yaml and docker/compose.arcadedb.yaml (and nuxeo-base.yaml): versions, passwords
# (development only) and host ports.
# The host ports, and the ports they avoid (other local stacks, Windows' reserved range): docs/port-mappings.md.

# ----- Nuxeo (both stacks) -----

# Nuxeo server: a commit of the public nuxeo/nuxeo repository (branch 2025, a mirror published almost daily, with
# commits about 3 months old).
# Use the commit of the local Nuxeo clone the graph storage is built and tested against (git -C <clone> rev-parse HEAD):
# the image builds Nuxeo and the graph storage from source, together.
NUXEO_GIT_REF=00b5bed6f966941679aa9762c0f5286375902e44

# Nuxeo Web UI: a commit (or tag) of the public nuxeo/nuxeo-web-ui repository (branch lts-2025): release v2025.21.0
NUXEO_WEBUI_GIT_REF=3ad7fe290f8a186cb490033a22048986997de207

# LibreOffice (office and text previews): the version of Nuxeo's own image, from The Document Foundation's archive
LIBREOFFICE_VERSION=7.5.9.2

# Maven threads of the Nuxeo build
BUILD_THREADS=6

# Web UI host ports: http://localhost:<port>/nuxeo/ui
NUXEO_NEO4J_PORT=8083
NUXEO_ARCADEDB_PORT=8084

# ----- Nuxeo's PostgreSQL (one per stack: users and groups, directories, audit, key/value store) -----

POSTGRES_VERSION=16-alpine
POSTGRES_PASSWORD=nuxeo

# ----- Nuxeo's search engine (one per stack: search and fulltext; Nuxeo's client is for OpenSearch 1.x) -----

# opensearch (OpenSearch 1.3, with OpenSearch Dashboards: Nuxeo's fully tested target) or elasticsearch (Elasticsearch 8,
# with Kibana). Each engine keeps its own volume: after switching, recreate the stack and reindex (see the README).
NUXEO_NEO4J_SEARCH_ENGINE=opensearch
NUXEO_ARCADEDB_SEARCH_ENGINE=opensearch
OPENSEARCH_VERSION=1.3.20
# Elasticsearch 8.19 (also Kibana's version): the Elasticsearch client of Oak 1.90 is 8.19, and Nuxeo's client works
# with Elasticsearch 8
ELASTICSEARCH_VERSION=8.19.23
# the search engine's HTTP API, and its dashboard (http://localhost:<port>)
NUXEO_NEO4J_SEARCH_PORT=9204
NUXEO_ARCADEDB_SEARCH_PORT=9205
NUXEO_NEO4J_SEARCH_DASHBOARDS_PORT=5605
NUXEO_ARCADEDB_SEARCH_DASHBOARDS_PORT=5606

# ----- Nuxeo's Kafka (one per stack: Nuxeo Stream, and the audit topic nuxeo-audit-audit for change sync) -----

# the version of Nuxeo's Kafka client
KAFKA_VERSION=3.9.2
KAFKA_UI_VERSION=v1.5.0
# Kafka for consumers on the host (Flexible GraphRAG: NUXEO_KAFKA_BOOTSTRAP_SERVERS=localhost:<port>), and Kafka UI
NUXEO_NEO4J_KAFKA_PORT=9092
NUXEO_ARCADEDB_KAFKA_PORT=9093
NUXEO_NEO4J_KAFKA_UI_PORT=8092
NUXEO_ARCADEDB_KAFKA_UI_PORT=8093

# ----- Neo4j (stack compose.neo4j.yaml) -----

NEO4J_VERSION=2026.09.0
# the image's admin user: must be neo4j (the image only sets its password)
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
# Neo4j Browser
NEO4J_HTTP_PORT=7476
NEO4J_BOLT_PORT=7691

# ----- ArcadeDB (stack compose.arcadedb.yaml) -----

ARCADEDB_VERSION=26.10.1
# the server's admin user: must be root (the server only sets its password)
ARCADEDB_USERNAME=root
ARCADEDB_PASSWORD=playwithdata
# ArcadeDB Studio and HTTP API
ARCADEDB_HTTP_PORT=2491
